<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/white_to_night"

    >


    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_tab1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/light_and_dark"

            >

            <ImageView
                android:id="@+id/image_tab1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerVertical="true"
                android:layout_marginVertical="18dp"
                android:layout_marginStart="10dp" />

            <TextView
                android:id="@+id/title_tab1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/info_tab1"
                android:layout_toEndOf="@+id/image_tab1"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingHorizontal="10dp"
                android:text=""
                android:textColor="@color/night_to_white"
                android:textSize="16sp"
                android:textStyle="bold"

                />

            <Button
                android:id="@+id/info_tab1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_info"
                android:padding="10sp"
                android:textSize="12sp"
                android:backgroundTint="@color/white_to_night"

                />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/ads_image"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignTop="@id/cardview_tab1"
        android:layout_alignEnd="@id/cardview_tab1"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@drawable/color_blindness_bac_btns"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:src="@drawable/icon_ads" />
</RelativeLayout>