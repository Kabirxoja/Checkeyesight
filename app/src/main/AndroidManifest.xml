<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--vibration permission-->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- alarm manager  -->
    <!-- AlarmManager uchun exact alarm (Android 12+ da tekshiriladi, lekin permission zarur emas, faqat manifestda e'lon qilish yetarli emas) -->
    <!-- SCHEDULE_EXACT_ALARM permission normal emas, shuning uchun manifestga yozilmaydi -->
    <!-- Notifications uchun (Android 13+ da runtime ruxsat so'raladi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Telefon reboot bo'lganda alarmlarni qayta schedule qilish uchun -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: Alarm vaqtida telefonni uyg'otish uchun (ko'pincha kerak emas, lekin xavfsizlik uchun) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />



    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CheckEyesight"
        tools:targetApi="31">
        <activity
            android:name=".main.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:isScrollContainer="false"
            android:windowSoftInputMode="adjustPan"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--        <receiver android:name=".alarm.AlarmReceiver" android:enabled="true" android:exported="false">-->
<!--            <intent-filter android:priority="1000">-->
<!--                <action android:name="android.intent.action.BOOT_COMPLETED" />-->
<!--            </intent-filter>
-->
<!--        </receiver>-->

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

    </application>

</manifest>